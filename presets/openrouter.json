{
  "id": "openrouter",
  "name": "OpenRouter",
  "sources": [
    "https://openrouter.ai/docs/guides/guides/claude-code-integration",
    "https://openrouter.ai/docs/api/reference/responses/overview",
    "https://openrouter.ai/api/v1/models"
  ],
  "agents": {
    "claude-code": {
      "protocol": "messages",
      "options": { "--base-url": "https://openrouter.ai/api", "--model": "anthropic/claude-sonnet-4.5" }
    },
    "codex": {
      "protocol": "responses",
      "options": { "--base-url": "https://openrouter.ai/api/v1", "--display-name": "OpenRouter" },
      "useOptions": { "--model": "openai/gpt-5.4" }
    },
    "opencode": {
      "protocol": "chat_completions",
      "options": { "--base-url": "https://openrouter.ai/api/v1", "--npm": "@ai-sdk/openai-compatible", "--model": ["anthropic/claude-sonnet-4.5"] }
    },
    "pi": {
      "protocol": "chat_completions",
      "options": { "--base-url": "https://openrouter.ai/api/v1", "--api": "openai-completions", "--model": ["anthropic/claude-sonnet-4.5"] }
    },
    "grok-build": {
      "protocol": "chat_completions",
      "options": { "--base-url": "https://openrouter.ai/api/v1", "--api-backend": "chat_completions", "--model": "anthropic/claude-sonnet-4.5" }
    }
  }
}
